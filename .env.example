# Variáveis de ambiente — Busca Aérea
# Copie para .env e preencha. Não commite o .env.

# === OBRIGATÓRIAS ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/busca_aerea?schema=public
AUTH_SECRET=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Busca Aérea
CRON_SECRET=
ADMIN_EMAILS=

# === APP ===
DEFAULT_CURRENCY=BRL
PROVIDER_TIMEOUT_MS=20000
SEARCH_CACHE_TTL_SECONDS=600

# Seed opcional do admin (npm run prisma:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# === PROVIDERS DE VOO ===
# Duffel (principal) — aceita DUFFEL_API_KEY ou DUFFEL_API_KEY_LIVE
DUFFEL_API_KEY=
DUFFEL_API_KEY_LIVE=

# Ignav (secundário)
IGNAV_API_KEY=

# Seats.aero (milhas, opcional)
SEATS_AERO_API_KEY=

# === SMTP (alertas por e-mail) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
