# Variáveis de ambiente — Busca Aérea
# Copie para .env e preencha. Não commite o .env.

# === OBRIGATÓRIAS ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/busca_aerea?schema=public
AUTH_SECRET=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Busca Aérea
CRON_SECRET=
ADMIN_EMAILS=

# === APP ===
DEFAULT_CURRENCY=BRL
PROVIDER_TIMEOUT_MS=20000
SEARCH_CACHE_TTL_SECONDS=600

# Seed opcional do admin (npm run prisma:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# === PROVIDERS DE VOO ===
# Duffel (principal) — aceita DUFFEL_API_KEY ou DUFFEL_API_KEY_LIVE
DUFFEL_API_KEY=
DUFFEL_API_KEY_LIVE=

# Ignav (secundário)
IGNAV_API_KEY=

# Kiwi.com e Skiplagged — fontes gratuitas, SEM chave.
# O backend chama os endpoints públicos automaticamente.

# Seats.aero (milhas, opcional)
SEATS_AERO_API_KEY=

# === SMTP (alertas por e-mail) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === ANÚNCIOS E AFILIADOS ===
# true/false — desliga todos os espaços se false
ADS_ENABLED=true
# true apenas em desenvolvimento para ver um slot demo sem JSON
ADS_DEMO=false
# JSON array de slots. Exemplo:
# ADS_CONFIG_JSON=[{"id":"home-1","placement":"home_top","enabled":true,"title":"Seguro viagem","description":"Compare coberturas","ctaLabel":"Ver oferta","targetUrl":"https://parceiro.exemplo/oferta","partner":"seguro-x","sponsored":true,"imageUrl":"https://..."}]
# Placements: home_top | home_bottom | results_top | results_inline | footer
ADS_CONFIG_JSON=

# === MONITORAMENTO TÉCNICO (opcional) ===
# Vazio = desativado. Webhook recebe JSON sem PII/chaves.
# MONITORING_WEBHOOK_URL=https://seu-collector.exemplo/ingest
MONITORING_WEBHOOK_URL=
# Alias aceito:
# MONITORING_ENDPOINT=
